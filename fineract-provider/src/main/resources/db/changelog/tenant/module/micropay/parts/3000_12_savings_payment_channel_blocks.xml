<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   logicalFilePath="db/changelog/tenant/parts/0252_savings_payment_channel_blocks.xml"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_savings_account_payment_channel_block"/>
            </not>
        </preConditions>
        <createTable tableName="m_savings_account_payment_channel_block">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="product_payment_channel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="blocked_on_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="unblocked_on_date" type="DATE"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="savings_account_id" baseTableName="m_savings_account_payment_channel_block"
                                 constraintName="FK_sap_channel_block_account" referencedColumnNames="id"
                                 referencedTableName="m_savings_account" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseColumnNames="product_payment_channel_id"
                                 baseTableName="m_savings_account_payment_channel_block"
                                 constraintName="FK_sap_channel_block_product_channel" referencedColumnNames="id"
                                 referencedTableName="m_savings_product_payment_channel"/>
        <createIndex indexName="idx_sap_channel_block_account" tableName="m_savings_account_payment_channel_block">
            <column name="savings_account_id"/>
            <column name="product_payment_channel_id"/>
            <column name="unblocked_on_date"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_savings_product_payment_channel_hold"/>
            </not>
        </preConditions>
        <createTable tableName="m_savings_product_payment_channel_hold">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="product_payment_channel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="started_on_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="ended_on_date" type="DATE"/>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="product_payment_channel_id"
                                 baseTableName="m_savings_product_payment_channel_hold"
                                 constraintName="FK_spp_channel_hold_channel" referencedColumnNames="id"
                                 referencedTableName="m_savings_product_payment_channel" onDelete="CASCADE"/>
        <createIndex indexName="idx_spp_channel_hold_channel" tableName="m_savings_product_payment_channel_hold">
            <column name="product_payment_channel_id"/>
            <column name="ended_on_date"/>
        </createIndex>
    </changeSet>

    <changeSet author="fineract" id="3">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from m_permission where code = 'BLOCK_SAVINGSACCOUNTPAYMENTCHANNEL'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="BLOCK_SAVINGSACCOUNTPAYMENTCHANNEL"/>
            <column name="entity_name" value="SAVINGSACCOUNTPAYMENTCHANNEL"/>
            <column name="action_name" value="BLOCK"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="4">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">select count(1) from m_permission where code = 'UNBLOCK_SAVINGSACCOUNTPAYMENTCHANNEL'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="UNBLOCK_SAVINGSACCOUNTPAYMENTCHANNEL"/>
            <column name="entity_name" value="SAVINGSACCOUNTPAYMENTCHANNEL"/>
            <column name="action_name" value="UNBLOCK"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="5">
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT rp.role_id, p_new.id
            FROM m_role_permission rp
            INNER JOIN m_permission p_old ON p_old.id = rp.permission_id AND p_old.code = 'UPDATE_SAVINGSACCOUNT'
            CROSS JOIN m_permission p_new
            WHERE p_new.code IN ('BLOCK_SAVINGSACCOUNTPAYMENTCHANNEL', 'UNBLOCK_SAVINGSACCOUNTPAYMENTCHANNEL')
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission existing
                  WHERE existing.role_id = rp.role_id AND existing.permission_id = p_new.id
              );
        </sql>
    </changeSet>
    <changeSet author="fineract" id="6">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="m_savings_product_payment_channel_hold"/>
            <tableExists tableName="m_savings_product_payment_channel"/>
        </preConditions>
        <sql>
            INSERT INTO m_savings_product_payment_channel_hold (product_payment_channel_id, started_on_date)
            SELECT c.id, CURRENT_DATE
            FROM m_savings_product_payment_channel c
            WHERE c.is_active = false
              AND NOT EXISTS (
                  SELECT 1 FROM m_savings_product_payment_channel_hold h
                  WHERE h.product_payment_channel_id = c.id AND h.ended_on_date IS NULL
              );
        </sql>
    </changeSet>
</databaseChangeLog>
