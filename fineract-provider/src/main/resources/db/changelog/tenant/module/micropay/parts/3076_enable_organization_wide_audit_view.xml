<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3076-enable-organization-wide-audit-view-config" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM c_configuration WHERE name = 'enable-organization-wide-audit-view'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="enable-organization-wide-audit-view"/>
            <column name="value" valueNumeric="0"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="When enabled, users with READ_AUDIT and VIEW_ORGANIZATION_AUDIT may view audit trails organization-wide. Maker-checker inbox remains branch-scoped."/>
        </insert>
    </changeSet>

    <changeSet id="3076-view-organization-audit-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'VIEW_ORGANIZATION_AUDIT'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="configuration"/>
            <column name="code" value="VIEW_ORGANIZATION_AUDIT"/>
            <column name="entity_name" value="AUDIT"/>
            <column name="action_name" value="VIEW_ORGANIZATION"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
