<?xml version="1.0" encoding="UTF-8"?>
<!--
  MICROPAY CBS: permissions for department reference data API (/v1/departments).
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3068-read-department-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'READ_DEPARTMENT'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="accounting"/>
            <column name="code" value="READ_DEPARTMENT"/>
            <column name="entity_name" value="DEPARTMENT"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
