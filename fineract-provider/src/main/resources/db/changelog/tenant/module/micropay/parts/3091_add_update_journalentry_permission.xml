<?xml version="1.0" encoding="UTF-8"?>
<!--
  MICROPAY CBS: permission to update journal entry narration (comments/description only).
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3091-update-journalentry-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'UPDATE_JOURNALENTRY'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="accounting"/>
            <column name="code" value="UPDATE_JOURNALENTRY"/>
            <column name="entity_name" value="JOURNALENTRY"/>
            <column name="action_name" value="UPDATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
