<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3054-add-transaction-office-id-columns" author="micropay">
        <addColumn tableName="m_savings_account_transaction">
            <column name="transaction_office_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="m_loan_transaction">
            <column name="transaction_office_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="m_client_transaction">
            <column name="transaction_office_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="3054-add-savings-transaction-office-fk" author="micropay">
        <addForeignKeyConstraint baseColumnNames="transaction_office_id" baseTableName="m_savings_account_transaction"
                                 constraintName="FK_savings_txn_transaction_office_id" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_office" validate="true"/>
    </changeSet>

    <changeSet id="3054-add-loan-transaction-office-fk" author="micropay">
        <addForeignKeyConstraint baseColumnNames="transaction_office_id" baseTableName="m_loan_transaction"
                                 constraintName="FK_loan_txn_transaction_office_id" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_office" validate="true"/>
    </changeSet>

    <changeSet id="3054-add-client-transaction-office-fk" author="micropay">
        <addForeignKeyConstraint baseColumnNames="transaction_office_id" baseTableName="m_client_transaction"
                                 constraintName="FK_client_txn_transaction_office_id" deferrable="false" initiallyDeferred="false"
                                 onDelete="RESTRICT" onUpdate="RESTRICT" referencedColumnNames="id"
                                 referencedTableName="m_office" validate="true"/>
    </changeSet>

    <changeSet id="3054-transact-crossoffice-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'TRANSACT_CROSSOFFICE'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="TRANSACT_CROSSOFFICE"/>
            <column name="entity_name" value="CLIENT"/>
            <column name="action_name" value="TRANSACT_CROSSOFFICE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
