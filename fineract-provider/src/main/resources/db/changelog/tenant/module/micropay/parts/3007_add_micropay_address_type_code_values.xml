<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="3007-1" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_code_value cv
                JOIN m_code c ON cv.code_id = c.id
                WHERE c.code_name = 'ADDRESS_TYPE' AND cv.code_value = 'Residential/Home'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code_value">
            <column name="code_id" valueComputed="(SELECT id FROM m_code WHERE code_name = 'ADDRESS_TYPE')"/>
            <column name="code_value" value="Residential/Home"/>
            <column name="code_description" value="Residential or home address"/>
            <column name="order_position" valueNumeric="1"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
        </insert>
    </changeSet>

