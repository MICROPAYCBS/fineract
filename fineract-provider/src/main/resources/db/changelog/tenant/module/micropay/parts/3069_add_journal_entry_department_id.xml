<?xml version="1.0" encoding="UTF-8"?>
<!--
  MICROPAY CBS: optional department on journal entry lines.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="3069-add-journal-entry-department-id" author="micropay">
        <addColumn tableName="acc_gl_journal_entry">
            <column name="department_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="acc_gl_journal_entry"
                                 baseColumnNames="department_id"
                                 constraintName="fk_acc_gl_journal_entry_department_id"
                                 referencedTableName="m_department"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
