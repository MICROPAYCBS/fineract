<?xml version="1.0" encoding="UTF-8"?>
<!--
  MICROPAY CBS: General Ledger report — department filter (ALL / specific department).
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="micropay" id="3083-general-ledger-department-parameter">
        <sql>
            INSERT INTO stretchy_report_parameter (report_id, parameter_id, report_parameter_name)
            SELECT sr.id, 3070, 'departmentId'
            FROM stretchy_report sr
            WHERE sr.report_name = 'GeneralLedgerReport Table'
              AND NOT EXISTS (
                SELECT 1 FROM stretchy_report_parameter existing
                WHERE existing.report_id = sr.id AND existing.parameter_id = 3070
              );
        </sql>
    </changeSet>

    <changeSet author="micropay" id="3083-postgresql-general-ledger-department-filter" context="postgresql">
        <sqlFile path="V3083__general_ledger_report_department_filter.postgresql.sql"
            relativeToChangelogFile="true"
            splitStatements="false"
            stripComments="false"/>
    </changeSet>

    <changeSet author="micropay" id="3083-mysql-general-ledger-department-filter" context="mysql">
        <sqlFile path="V3083__general_ledger_report_department_filter.mysql.sql"
            relativeToChangelogFile="true"
            splitStatements="false"
            stripComments="false"/>
    </changeSet>

</databaseChangeLog>
