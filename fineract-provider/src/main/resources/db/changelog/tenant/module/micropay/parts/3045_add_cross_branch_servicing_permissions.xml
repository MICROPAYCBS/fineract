    <changeSet id="3045-view-other-branch-client-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'VIEW_OTHER_BRANCH_CLIENT'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="portfolio"/>
            <column name="code" value="VIEW_OTHER_BRANCH_CLIENT"/>
            <column name="entity_name" value="CLIENT"/>
            <column name="action_name" value="VIEW_OTHER_BRANCH"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

