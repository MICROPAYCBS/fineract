<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3063-create-m-currency-legal-tender" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_currency_legal_tender"/>
            </not>
        </preConditions>
        <createTable tableName="m_currency_legal_tender">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="tender_type" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_currency_legal_tender"
                             columnNames="currency_code, value, tender_type"
                             constraintName="uk_currency_legal_tender_code_value_type"/>
        <addForeignKeyConstraint baseTableName="m_currency_legal_tender" baseColumnNames="currency_code"
                                 referencedTableName="m_currency" referencedColumnNames="code"
                                 constraintName="fk_currency_legal_tender_currency"/>
    </changeSet>

    <changeSet id="3063-create-m-cashier-transaction-legal-tender" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_cashier_transaction_legal_tender"/>
            </not>
        </preConditions>
        <createTable tableName="m_cashier_transaction_legal_tender">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="cashier_transaction_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="legal_tender_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="line_amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_cashier_transaction_legal_tender"
                             columnNames="cashier_transaction_id, legal_tender_id"
                             constraintName="uk_cashier_txn_legal_tender"/>
        <addForeignKeyConstraint baseTableName="m_cashier_transaction_legal_tender" baseColumnNames="cashier_transaction_id"
                                 referencedTableName="m_cashier_transactions" referencedColumnNames="id"
                                 constraintName="fk_cashier_txn_legal_tender_txn"/>
        <addForeignKeyConstraint baseTableName="m_cashier_transaction_legal_tender" baseColumnNames="legal_tender_id"
                                 referencedTableName="m_currency_legal_tender" referencedColumnNames="id"
                                 constraintName="fk_cashier_txn_legal_tender_master"/>
    </changeSet>

