<?xml version="1.0" encoding="UTF-8"?>
<!--
  Loan report filters treat -1 as "all". The stretchy default of 0 does not match that sentinel and,
  when omitted from the request, breaks prepared-statement binding for ${loanPurposeId}.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="micropay" id="3060-fix-loan-purpose-report-parameter-default">
        <update tableName="stretchy_parameter">
            <column name="parameter_default" value="-1"/>
            <where>parameter_name = 'loanPurposeIdSelectAll'</where>
        </update>
    </changeSet>

</databaseChangeLog>
