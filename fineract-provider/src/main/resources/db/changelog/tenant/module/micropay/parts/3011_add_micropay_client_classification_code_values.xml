    <changeSet id="3011-1" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_code_value cv
                JOIN m_code c ON cv.code_id = c.id
                WHERE c.code_name = 'ClientClassification' AND cv.code_value = 'Urban'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code_value">
            <column name="code_id" valueComputed="(SELECT id FROM m_code WHERE code_name = 'ClientClassification')"/>
            <column name="code_value" value="Urban"/>
            <column name="code_description" value="Urban classification"/>
            <column name="order_position" valueNumeric="1"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
        </insert>
    </changeSet>

