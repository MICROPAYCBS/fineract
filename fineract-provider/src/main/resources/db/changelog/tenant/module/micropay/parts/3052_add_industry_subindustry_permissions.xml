<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"

    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"

    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">



    <changeSet id="3052-read-industry-permission" author="micropay">

        <preConditions onFail="MARK_RAN">

            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'READ_INDUSTRY'</sqlCheck>

        </preConditions>

        <insert tableName="m_permission">

            <column name="grouping" value="portfolio"/>

            <column name="code" value="READ_INDUSTRY"/>

            <column name="entity_name" value="INDUSTRY"/>

            <column name="action_name" value="READ"/>

            <column name="can_maker_checker" valueBoolean="false"/>

        </insert>

    </changeSet>

