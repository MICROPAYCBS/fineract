<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3062-require-cashier-for-cash-transactions-config" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM c_configuration WHERE name = 'require-cashier-for-cash-transactions'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="require-cashier-for-cash-transactions"/>
            <column name="value" valueNumeric="1"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Require an active cashier session for cash deposits and withdrawals. Disable to allow cash transactions without an open cashier allocation."/>
        </insert>
    </changeSet>

</databaseChangeLog>
