<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Enable geographic address fields for Micropay (Region through Village).
         Fineract field mapping (values supplied client-side from locations.json):
           stateProvinceId -> Region (STATE code values)
           city            -> District
           countyDistrict  -> County
           addressLine1    -> SubCounty
           addressLine2    -> Parish
           townVillage     -> Village
         Supplemental fields (optional, still supported): street, addressLine1–3, countryId, postalCode -->
    <changeSet id="3012-enable-townVillage" author="micropay">
        <update tableName="m_field_configuration">
            <column name="is_enabled" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
            <where>entity = 'ADDRESS' AND subentity = 'CLIENT' AND field = 'townVillage'</where>
        </update>
    </changeSet>

    <changeSet id="3012-enable-countyDistrict" author="micropay">
        <update tableName="m_field_configuration">
            <column name="is_enabled" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
            <where>entity = 'ADDRESS' AND subentity = 'CLIENT' AND field = 'countyDistrict'</where>
        </update>
    </changeSet>

    <changeSet id="3012-optional-geographic-address-fields" author="micropay">
        <update tableName="m_field_configuration">
            <column name="is_enabled" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
            <where>entity = 'ADDRESS' AND subentity = 'CLIENT' AND field IN ('city', 'stateProvinceId', 'addressLine1', 'addressLine2', 'addressLine3')</where>
        </update>
    </changeSet>

    <changeSet id="3012-enable-street" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_field_configuration
                WHERE entity = 'ADDRESS' AND subentity = 'CLIENT' AND field = 'street'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_field_configuration">
            <column name="entity" value="ADDRESS"/>
            <column name="subentity" value="CLIENT"/>
            <column name="field" value="street"/>
            <column name="is_enabled" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
            <column name="validation_regex" value=""/>
        </insert>
    </changeSet>

    <changeSet id="3012-optional-supplemental-address-fields" author="micropay">
        <update tableName="m_field_configuration">
            <column name="is_enabled" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
            <where>entity = 'ADDRESS' AND subentity = 'CLIENT' AND field IN ('street', 'countryId', 'postalCode')</where>
        </update>
    </changeSet>

    <!-- Uganda regions under Fineract STATE code (used by stateProvinceId / Region) -->
    <changeSet id="3012-region-central" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_code_value cv
                JOIN m_code c ON cv.code_id = c.id
                WHERE c.code_name = 'STATE' AND cv.code_value = 'Central'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code_value">
            <column name="code_id" valueComputed="(SELECT id FROM m_code WHERE code_name = 'STATE')"/>
            <column name="code_value" value="Central"/>
            <column name="code_description" value="Central Region"/>
            <column name="order_position" valueNumeric="1"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="3012-region-eastern" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_code_value cv
                JOIN m_code c ON cv.code_id = c.id
                WHERE c.code_name = 'STATE' AND cv.code_value = 'Eastern'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code_value">
            <column name="code_id" valueComputed="(SELECT id FROM m_code WHERE code_name = 'STATE')"/>
            <column name="code_value" value="Eastern"/>
            <column name="code_description" value="Eastern Region"/>
            <column name="order_position" valueNumeric="2"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="3012-region-northern" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_code_value cv
                JOIN m_code c ON cv.code_id = c.id
                WHERE c.code_name = 'STATE' AND cv.code_value = 'Northern'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code_value">
            <column name="code_id" valueComputed="(SELECT id FROM m_code WHERE code_name = 'STATE')"/>
            <column name="code_value" value="Northern"/>
            <column name="code_description" value="Northern Region"/>
            <column name="order_position" valueNumeric="3"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="3012-region-western" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_code_value cv
                JOIN m_code c ON cv.code_id = c.id
                WHERE c.code_name = 'STATE' AND cv.code_value = 'Western'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_code_value">
            <column name="code_id" valueComputed="(SELECT id FROM m_code WHERE code_name = 'STATE')"/>
            <column name="code_value" value="Western"/>
            <column name="code_description" value="Western Region"/>
            <column name="order_position" valueNumeric="4"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="is_mandatory" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
