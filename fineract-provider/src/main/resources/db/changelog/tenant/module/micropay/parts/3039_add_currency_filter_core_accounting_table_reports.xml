<?xml version="1.0" encoding="UTF-8"?>
<!--
  MICROPAY CBS: add currency filter to core accounting table reports (multi-currency branches).
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="micropay" id="3039-mysql-currency-filter" context="mysql">
        <sqlFile path="V3039__core_accounting_reports_currency_filter.mysql.sql"
            relativeToChangelogFile="true"
            splitStatements="true"
            stripComments="false"/>
    </changeSet>

    <changeSet author="micropay" id="3039-postgresql-currency-filter" context="postgresql">
        <sqlFile path="V3039__core_accounting_reports_currency_filter.postgresql.sql"
            relativeToChangelogFile="true"
            splitStatements="true"
            stripComments="false"/>
    </changeSet>

    <changeSet author="micropay" id="3039-currency-report-parameters">
        <sql>
            INSERT INTO stretchy_report_parameter (report_id, parameter_id, report_parameter_name)
            SELECT sr.id, 10, 'currencyId'
            FROM stretchy_report sr
            WHERE sr.report_name IN ('Trial Balance Table', 'Balance Sheet Table', 'Income Statement Table')
              AND NOT EXISTS (
                SELECT 1 FROM stretchy_report_parameter existing
                WHERE existing.report_id = sr.id AND existing.parameter_id = 10
              );
        </sql>
    </changeSet>

</databaseChangeLog>
