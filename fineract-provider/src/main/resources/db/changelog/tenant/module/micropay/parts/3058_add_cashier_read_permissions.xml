<?xml version="1.0" encoding="UTF-8"?>
<!--
  MICROPAY CBS: permissions for scoped teller/cashier read access.
  READ_TELLER — list/view all cashiers in office hierarchy (managers).
  READ_MY_CASHIER — view only the cashier row linked to the user's staff record.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3058-read-teller-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'READ_TELLER'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="cash_mgmt"/>
            <column name="code" value="READ_TELLER"/>
            <column name="entity_name" value="TELLER"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="3058-read-my-cashier-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'READ_MY_CASHIER'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="cash_mgmt"/>
            <column name="code" value="READ_MY_CASHIER"/>
            <column name="entity_name" value="CASHIER"/>
            <column name="action_name" value="READ_MY"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
