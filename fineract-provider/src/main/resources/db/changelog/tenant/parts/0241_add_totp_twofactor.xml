<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet author="fineract" id="1">
        <addColumn tableName="m_appuser">
            <column name="totp_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="totp_secret" type="VARCHAR(512)"/>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="2">
        <insert tableName="twofactor_configuration">
            <column name="name" value="otp-delivery-method"/>
            <column name="value" value="email"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="3">
        <comment>Derive global delivery method from legacy email/sms enable flags</comment>
        <sql>
            UPDATE twofactor_configuration
            SET value = 'sms'
            WHERE name = 'otp-delivery-method'
              AND EXISTS (
                  SELECT 1 FROM twofactor_configuration sms
                  WHERE sms.name = 'otp-delivery-sms-enable'
                    AND LOWER(sms.value) IN ('true', '1', 'yes')
              )
              AND NOT EXISTS (
                  SELECT 1 FROM twofactor_configuration email
                  WHERE email.name = 'otp-delivery-email-enable'
                    AND LOWER(email.value) IN ('true', '1', 'yes')
              );
        </sql>
    </changeSet>

    <changeSet author="fineract" id="4">
        <insert tableName="m_permission">
            <column name="grouping" value="authorisation"/>
            <column name="code" value="RESETTOTP_USER"/>
            <column name="entity_name" value="USER"/>
            <column name="action_name" value="RESETTOTP"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="5">
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT rp.role_id, p_new.id
            FROM m_role_permission rp
            INNER JOIN m_permission p_old ON p_old.id = rp.permission_id AND p_old.code = 'UPDATE_USER'
            CROSS JOIN m_permission p_new
            WHERE p_new.code = 'RESETTOTP_USER'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission existing
                  WHERE existing.role_id = rp.role_id AND existing.permission_id = p_new.id
              );
        </sql>
    </changeSet>
</databaseChangeLog>
