<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <!--
        Two-factor access tokens are the server-side session for staff clients. The upstream
        defaults (24h standard / 7d extended) leave a stolen token usable far longer than a
        working day. Bound them to 12h / 48h. Only rows still holding the seeded upstream
        default are touched, so tenant-tuned values are preserved; the values remain
        adjustable afterwards via PUT /twofactor/configure.
    -->
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(1) from twofactor_configuration where name = 'access-token-live-time' and value = '86400'</sqlCheck>
        </preConditions>
        <update tableName="twofactor_configuration">
            <column name="value" value="43200"/>
            <where>name = 'access-token-live-time'</where>
        </update>
    </changeSet>
    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(1) from twofactor_configuration where name = 'access-token-live-time-extended' and value = '604800'</sqlCheck>
        </preConditions>
        <update tableName="twofactor_configuration">
            <column name="value" value="172800"/>
            <where>name = 'access-token-live-time-extended'</where>
        </update>
    </changeSet>
</databaseChangeLog>
