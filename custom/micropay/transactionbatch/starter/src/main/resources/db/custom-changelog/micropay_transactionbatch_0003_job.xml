<databaseChangeLog logicalFilePath="db/changelog/tenant/module/transactionbatch/parts/0003_job.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="current_datetime" value="NOW()"/>

    <!-- Inactive until an operator turns it on. short_name is 8 characters; the Spring Batch name is TXN_BATCH_POST. -->
    <changeSet id="txnbatch-job-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM job WHERE short_name = 'TXN_BTCH'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Transaction Batch Posting"/>
            <column name="display_name" value="Transaction Batch Posting"/>
            <column name="cron_expression" value="0 0/5 * * * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Transaction Batch Posting _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="false"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
            <column name="short_name" value="TXN_BTCH"/>
        </insert>
    </changeSet>

    <changeSet id="txnbatch-job-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="job" columnName="description"/>
        </preConditions>
        <update tableName="job">
            <column name="description" value="Posts Active transaction batches that are due: GL lines against the currency clearing account, and customer lines through GL to savings or savings to GL in the batch origin branch. A line that fails is suspended against the currency suspense account. Inactive until switched on."/>
            <where>short_name='TXN_BTCH' AND description IS NULL</where>
        </update>
    </changeSet>
</databaseChangeLog>
