<!--
  MICROPAY CBS: transaction batches. Links to upstream tables by id only.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/transactionbatch/parts/0001_schema.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="txnbatch.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="txnbatch.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="txnbatch-001-header" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="m_txn_batch"/></not>
        </preConditions>
        <createTable tableName="m_txn_batch">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="code" type="VARCHAR(20)"><constraints nullable="true" unique="true"/></column>
            <column name="description" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="office_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="is_recurring" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="effective_date" type="DATE"/>
            <column name="frequency_number" type="INT"/>
            <column name="frequency_unit" type="SMALLINT"/>
            <column name="next_posting_date" type="DATE"/>
            <column name="expiry_date" type="DATE"/>
            <column name="status" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="submitted_by" type="BIGINT"/>
            <column name="submitted_on" type="DATE"/>
            <column name="decided_by" type="BIGINT"/>
            <column name="decided_on" type="DATE"/>
            <column name="posted_by" type="BIGINT"/>
            <column name="posted_on" type="DATE"/>
            <column name="copied_from_batch_id" type="BIGINT"/>
            <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_on_utc" type="${txnbatch.datetime.type}"><constraints nullable="false"/></column>
            <column name="last_modified_by" type="BIGINT"><constraints nullable="false"/></column>
            <column name="last_modified_on_utc" type="${txnbatch.datetime.type}"><constraints nullable="false"/></column>
            <column name="version" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_txn_batch" baseColumnNames="office_id" constraintName="fk_txn_batch_office"
                                 referencedTableName="m_office" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_txn_batch" baseColumnNames="copied_from_batch_id" constraintName="fk_txn_batch_copied_from"
                                 referencedTableName="m_txn_batch" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="txnbatch-002-item" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="m_txn_batch_item"/></not>
        </preConditions>
        <createTable tableName="m_txn_batch_item">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="batch_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="account_type" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="gl_account_id" type="BIGINT"/>
            <column name="savings_account_id" type="BIGINT"/>
            <column name="side" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="currency_code" type="VARCHAR(3)"><constraints nullable="false"/></column>
            <column name="amount" type="DECIMAL(19,6)"><constraints nullable="false"/></column>
            <column name="narrative" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="reference" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="value_date" type="DATE"><constraints nullable="false"/></column>
            <column name="status" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="last_error" type="VARCHAR(1000)"/>
            <column name="created_by" type="BIGINT"><constraints nullable="false"/></column>
            <column name="created_on_utc" type="${txnbatch.datetime.type}"><constraints nullable="false"/></column>
            <column name="last_modified_by" type="BIGINT"><constraints nullable="false"/></column>
            <column name="last_modified_on_utc" type="${txnbatch.datetime.type}"><constraints nullable="false"/></column>
            <column name="version" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_txn_batch_item" baseColumnNames="batch_id" constraintName="fk_txn_batch_item_batch"
                                 referencedTableName="m_txn_batch" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_txn_batch_item" baseColumnNames="gl_account_id" constraintName="fk_txn_batch_item_gl"
                                 referencedTableName="acc_gl_account" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_txn_batch_item" baseColumnNames="savings_account_id" constraintName="fk_txn_batch_item_savings"
                                 referencedTableName="m_savings_account" referencedColumnNames="id"/>
        <createIndex tableName="m_txn_batch_item" indexName="idx_txn_batch_item_batch"><column name="batch_id"/></createIndex>
        <sql>
            ALTER TABLE m_txn_batch_item ADD CONSTRAINT ck_txn_batch_item_one_account CHECK (
                (account_type = 1 AND gl_account_id IS NOT NULL AND savings_account_id IS NULL)
                OR (account_type = 2 AND gl_account_id IS NULL AND savings_account_id IS NOT NULL)
            )
        </sql>
    </changeSet>

    <changeSet id="txnbatch-003-run" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="m_txn_batch_run"/></not>
        </preConditions>
        <createTable tableName="m_txn_batch_run">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="batch_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="run_no" type="INT"><constraints nullable="false"/></column>
            <column name="run_date" type="DATE"><constraints nullable="false"/></column>
            <column name="status" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="posted_count" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="suspended_count" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="started_on_utc" type="${txnbatch.datetime.type}"><constraints nullable="false"/></column>
            <column name="completed_on_utc" type="${txnbatch.datetime.type}"/>
            <column name="run_by" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_txn_batch_run" baseColumnNames="batch_id" constraintName="fk_txn_batch_run_batch"
                                 referencedTableName="m_txn_batch" referencedColumnNames="id"/>
        <addUniqueConstraint tableName="m_txn_batch_run" columnNames="batch_id, run_no" constraintName="uq_txn_batch_run_no"/>
        <addUniqueConstraint tableName="m_txn_batch_run" columnNames="batch_id, run_date" constraintName="uq_txn_batch_run_date"/>
    </changeSet>

    <changeSet id="txnbatch-004-posting" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="m_txn_batch_posting"/></not>
        </preConditions>
        <createTable tableName="m_txn_batch_posting">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="run_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="item_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="status" type="SMALLINT"><constraints nullable="false"/></column>
            <column name="error" type="VARCHAR(1000)"/>
            <column name="journal_transaction_id" type="VARCHAR(50)"/>
            <column name="savings_transaction_id" type="BIGINT"/>
            <column name="suspense_transaction_id" type="VARCHAR(50)"/>
            <column name="repair_journal_transaction_id" type="VARCHAR(50)"/>
            <column name="repair_savings_transaction_id" type="BIGINT"/>
            <column name="repaired_by" type="BIGINT"/>
            <column name="repaired_on" type="DATE"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${txnbatch.datetime.type}"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="${txnbatch.datetime.type}"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_txn_batch_posting" baseColumnNames="run_id" constraintName="fk_txn_batch_posting_run"
                                 referencedTableName="m_txn_batch_run" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_txn_batch_posting" baseColumnNames="item_id" constraintName="fk_txn_batch_posting_item"
                                 referencedTableName="m_txn_batch_item" referencedColumnNames="id"/>
        <addUniqueConstraint tableName="m_txn_batch_posting" columnNames="run_id, item_id" constraintName="uq_txn_batch_posting_run_item"/>
    </changeSet>

    <changeSet id="txnbatch-005-setting" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="m_txn_batch_setting"/></not>
        </preConditions>
        <createTable tableName="m_txn_batch_setting">
            <column name="currency_code" type="VARCHAR(3)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="clearing_gl_account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="suspense_gl_account_id" type="BIGINT"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint baseTableName="m_txn_batch_setting" baseColumnNames="clearing_gl_account_id"
                                 constraintName="fk_txn_batch_setting_clearing" referencedTableName="acc_gl_account" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_txn_batch_setting" baseColumnNames="suspense_gl_account_id"
                                 constraintName="fk_txn_batch_setting_suspense" referencedTableName="acc_gl_account" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="txnbatch-006-config" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="m_txn_batch_config"/></not>
        </preConditions>
        <createTable tableName="m_txn_batch_config">
            <column name="id" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="code_prefix" type="VARCHAR(10)" defaultValue="100"><constraints nullable="false"/></column>
            <column name="import_row_cap" type="INT" defaultValueNumeric="5000"><constraints nullable="false"/></column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${txnbatch.datetime.type}"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="${txnbatch.datetime.type}"/>
            <column name="version" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column>
        </createTable>
        <sql>ALTER TABLE m_txn_batch_config ADD CONSTRAINT ck_txn_batch_config_singleton CHECK (id = 1)</sql>
        <insert tableName="m_txn_batch_config">
            <column name="id" valueNumeric="1"/>
            <column name="code_prefix" value="100"/>
            <column name="import_row_cap" valueNumeric="5000"/>
            <column name="created_on_utc" valueDate="${current_datetime}"/>
            <column name="last_modified_on_utc" valueDate="${current_datetime}"/>
            <column name="version" valueNumeric="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
