<!--
  MICROPAY CBS: structured account numbers apply only where a preference has structured_enabled = true.
  Existing NULL flags meant "structured" before this change; set them to false so the stored value matches.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/micropay/parts/3105_account_number_structured_flag.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3105-account-number-structured-flag-not-null" author="micropay">
        <update tableName="c_account_number_format">
            <column name="structured_enabled" valueBoolean="false"/>
            <where>structured_enabled IS NULL</where>
        </update>
        <addNotNullConstraint tableName="c_account_number_format" columnName="structured_enabled"
                              columnDataType="BOOLEAN" defaultNullValue="false"/>
    </changeSet>

    <changeSet id="3105-structured-account-number-formats-description" author="micropay">
        <update tableName="c_configuration">
            <column name="description" value="Makes structured account numbers (branch + product + sequence + check digit) available. Each account type uses them only when its account number preference has Structured format turned on; other types keep legacy numbering. Applies to new accounts only."/>
            <where>name = 'structured-account-number-formats'</where>
        </update>
    </changeSet>

</databaseChangeLog>
