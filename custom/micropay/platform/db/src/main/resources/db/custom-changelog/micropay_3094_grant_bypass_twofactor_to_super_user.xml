<!--
  MICROPAY CBS: grant BYPASS_TWOFACTOR to the Super user role.

  2FA enforcement checks this permission via hasSpecificPermissionTo(), which does
  not treat ALL_FUNCTIONS as sufficient. Without an explicit grant, Super user is
  locked out of API access when two-factor is enabled and cannot complete setup.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/micropay/parts/3094_grant_bypass_twofactor_to_super_user.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3094-grant-bypass-twofactor-to-super-user" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">
                SELECT COUNT(1) FROM m_permission WHERE code = 'BYPASS_TWOFACTOR'
            </sqlCheck>
            <sqlCheck expectedResult="0">
                SELECT COUNT(1)
                FROM m_role_permission rp
                JOIN m_permission p ON p.id = rp.permission_id
                WHERE rp.role_id = 1 AND p.code = 'BYPASS_TWOFACTOR'
            </sqlCheck>
        </preConditions>
        <sql>
            INSERT INTO m_role_permission (role_id, permission_id)
            SELECT 1, p.id
            FROM m_permission p
            WHERE p.code = 'BYPASS_TWOFACTOR'
              AND NOT EXISTS (
                  SELECT 1 FROM m_role_permission rp
                  WHERE rp.role_id = 1 AND rp.permission_id = p.id
              );
        </sql>
    </changeSet>
</databaseChangeLog>
