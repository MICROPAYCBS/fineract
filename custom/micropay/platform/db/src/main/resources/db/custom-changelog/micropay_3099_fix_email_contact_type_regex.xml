<?xml version="1.0" encoding="UTF-8"?>
<!--
  MICROPAY CBS: the PostgreSQL seed V3036 stored the Email contact type regex with doubled
  backslashes, so no email address matched. Correct the row if it still holds the broken value.
  MySQL/MariaDB stored the correct value, so this runs on PostgreSQL only.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/micropay/parts/3099_fix_email_contact_type_regex.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3099-fix-email-contact-type-regex-postgresql" author="micropay" context="postgresql">
        <sql splitStatements="false">
            UPDATE m_contact_type
               SET validation_regex = E'^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$',
                   last_modified_on_utc = NOW(),
                   version = version + 1
             WHERE type_code = 'EMAIL'
               AND validation_regex = E'^[^@\\\\s]+@[^@\\\\s]+\\\\.[^@\\\\s]+$'
        </sql>
    </changeSet>

</databaseChangeLog>
