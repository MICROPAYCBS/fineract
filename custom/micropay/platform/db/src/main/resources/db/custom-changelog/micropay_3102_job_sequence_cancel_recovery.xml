<!--
  MICROPAY CBS: permission to cancel a running job sequence.
  Startup recovery of RUNNING rows is not included: fineract.node-id defaults to 1 and is shared
  across nodes, so failing RUNNING rows on startup would cancel another node's run.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/micropay/parts/3102_job_sequence_cancel_recovery.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="3102-cancel-jobsequence-permission" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'CANCEL_JOBSEQUENCE'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="jobs"/>
            <column name="code" value="CANCEL_JOBSEQUENCE"/>
            <column name="entity_name" value="JOBSEQUENCE"/>
            <column name="action_name" value="CANCEL"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
