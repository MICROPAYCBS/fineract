<!--
  MICROPAY CBS: fraud holds on clients, savings accounts and loans, and the account changes each hold made.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/fraud/parts/0002_holds.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="fraud-hold-001" author="micropay">
        <createTable tableName="m_fraud_hold">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="external_reference" type="VARCHAR(100)"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="released_by" type="BIGINT"/>
            <column name="released_on_utc" type="DATETIME"/>
            <column name="release_note" type="VARCHAR(500)"/>
        </createTable>
        <createIndex tableName="m_fraud_hold" indexName="idx_fraud_hold_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
    <changeSet id="fraud-hold-002" author="micropay">
        <!-- What a hold actually changed, so a release only reverts its own changes -->
        <createTable tableName="m_fraud_hold_effect">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hold_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_fraud_hold_effect_hold" referencedTableName="m_fraud_hold" referencedColumnNames="id"/>
            </column>
            <column name="effect_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_fraud_hold_effect" indexName="idx_fraud_hold_effect_target">
            <column name="effect_type"/>
            <column name="target_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
