<!--
  Fraud engine's own database (not Fineract's). Kept under db/fraud-engine so Fineract's custom-changelog scan never sees it.
-->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="fe-001-processed-event" author="micropay">
        <createTable tableName="fe_processed_event">
            <column name="tenant_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="event_key" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="processed_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="fe_processed_event" columnNames="tenant_id, event_key" constraintName="pk_fe_processed_event"/>
    </changeSet>

    <changeSet id="fe-002-client-and-owner" author="micropay">
        <createTable tableName="fe_client_profile">
            <column name="tenant_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="client_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="activation_date" type="DATE"/>
            <column name="office_id" type="BIGINT"/>
            <column name="display_name" type="VARCHAR(200)"/>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="fe_client_profile" columnNames="tenant_id, client_id" constraintName="pk_fe_client_profile"/>
        <createTable tableName="fe_account_owner">
            <column name="tenant_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="account_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="client_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="resolved_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="fe_account_owner" columnNames="tenant_id, account_type, account_id" constraintName="pk_fe_account_owner"/>
    </changeSet>

    <changeSet id="fe-003-transaction" author="micropay">
        <createTable tableName="fe_transaction">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="event_key" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="event_type" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="kind" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="debit" type="BOOLEAN"><constraints nullable="false"/></column>
            <column name="account_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="client_id" type="BIGINT"/>
            <column name="transaction_id" type="BIGINT"/>
            <column name="amount" type="DECIMAL(27,8)"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(10)"/>
            <column name="occurred_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="business_date" type="DATE"/>
            <column name="channel" type="VARCHAR(100)"/>
            <column name="risk_score" type="INT"><constraints nullable="false"/></column>
            <column name="anomaly_score" type="DOUBLE"/>
            <column name="features" type="VARCHAR(500)"/>
        </createTable>
        <createIndex tableName="fe_transaction" indexName="idx_fe_transaction_client">
            <column name="tenant_id"/>
            <column name="client_id"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="fe_transaction" indexName="idx_fe_transaction_account">
            <column name="tenant_id"/>
            <column name="account_type"/>
            <column name="account_id"/>
            <column name="occurred_at"/>
        </createIndex>
        <createIndex tableName="fe_transaction" indexName="idx_fe_transaction_tenant_time">
            <column name="tenant_id"/>
            <column name="occurred_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="fe-004-alert" author="micropay">
        <createTable tableName="fe_alert">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="tenant_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="transaction_ref" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_fe_alert_transaction" referencedTableName="fe_transaction" referencedColumnNames="id"/>
            </column>
            <column name="account_type" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="account_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="client_id" type="BIGINT"/>
            <column name="kind" type="VARCHAR(30)"><constraints nullable="false"/></column>
            <column name="amount" type="DECIMAL(27,8)"><constraints nullable="false"/></column>
            <column name="currency" type="VARCHAR(10)"/>
            <column name="occurred_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="risk_score" type="INT"><constraints nullable="false"/></column>
            <column name="severity" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="verdict" type="VARCHAR(20)"/>
            <column name="assigned_to" type="VARCHAR(100)"/>
            <column name="note" type="VARCHAR(1000)"/>
            <column name="fineract_hold_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="fe_alert" indexName="idx_fe_alert_queue">
            <column name="tenant_id"/>
            <column name="status"/>
            <column name="risk_score"/>
        </createIndex>
        <createIndex tableName="fe_alert" indexName="idx_fe_alert_client">
            <column name="tenant_id"/>
            <column name="client_id"/>
        </createIndex>
        <createTable tableName="fe_alert_reason">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="alert_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_fe_alert_reason_alert" referencedTableName="fe_alert" referencedColumnNames="id"/>
            </column>
            <column name="code" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="score" type="INT"><constraints nullable="false"/></column>
            <column name="detail" type="VARCHAR(500)"/>
        </createTable>
        <createIndex tableName="fe_alert_reason" indexName="idx_fe_alert_reason_alert">
            <column name="alert_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="fe-005-watchlist" author="micropay">
        <createTable tableName="fe_watchlist_source">
            <column name="source" type="VARCHAR(50)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="version" type="VARCHAR(100)"/>
            <column name="entry_count" type="INT"><constraints nullable="false"/></column>
            <column name="loaded_at" type="TIMESTAMP"/>
            <column name="checked_at" type="TIMESTAMP"/>
            <column name="last_error" type="VARCHAR(500)"/>
        </createTable>
        <createTable tableName="fe_watchlist_entry">
            <column name="source" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="entry_uid" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="party_type" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="primary_name" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="birth_dates" type="VARCHAR(500)"/>
            <column name="programs" type="VARCHAR(500)"/>
        </createTable>
        <addPrimaryKey tableName="fe_watchlist_entry" columnNames="source, entry_uid" constraintName="pk_fe_watchlist_entry"/>
        <createTable tableName="fe_watchlist_name">
            <column name="source" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="entry_uid" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(500)"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="fe_watchlist_name" indexName="idx_fe_watchlist_name_entry">
            <column name="source"/>
            <column name="entry_uid"/>
        </createIndex>
        <addColumn tableName="fe_client_profile">
            <column name="full_name" type="VARCHAR(300)"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="party_type" type="VARCHAR(10)"/>
            <column name="screened_at" type="TIMESTAMP"/>
            <column name="screened_version" type="VARCHAR(100)"/>
        </addColumn>
        <!-- Watchlist alerts concern a client, not a transaction -->
        <addColumn tableName="fe_alert">
            <column name="alert_type" type="VARCHAR(20)" defaultValue="TRANSACTION"><constraints nullable="false"/></column>
        </addColumn>
        <dropNotNullConstraint tableName="fe_alert" columnName="transaction_ref" columnDataType="BIGINT"/>
        <dropNotNullConstraint tableName="fe_alert" columnName="account_type" columnDataType="VARCHAR(20)"/>
        <dropNotNullConstraint tableName="fe_alert" columnName="account_id" columnDataType="BIGINT"/>
        <dropNotNullConstraint tableName="fe_alert" columnName="kind" columnDataType="VARCHAR(30)"/>
        <dropNotNullConstraint tableName="fe_alert" columnName="amount" columnDataType="DECIMAL(27,8)"/>
        <createTable tableName="fe_watchlist_match">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
            <column name="alert_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_fe_watchlist_match_alert" referencedTableName="fe_alert" referencedColumnNames="id"/>
            </column>
            <column name="tenant_id" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="client_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="source" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="entry_uid" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="entry_name" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="matched_name" type="VARCHAR(500)"><constraints nullable="false"/></column>
            <column name="client_name" type="VARCHAR(300)"><constraints nullable="false"/></column>
            <column name="score" type="INT"><constraints nullable="false"/></column>
            <column name="birth_date_check" type="VARCHAR(10)"><constraints nullable="false"/></column>
            <column name="programs" type="VARCHAR(500)"/>
        </createTable>
        <createIndex tableName="fe_watchlist_match" indexName="idx_fe_watchlist_match_pair">
            <column name="tenant_id"/>
            <column name="client_id"/>
            <column name="source"/>
            <column name="entry_uid"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
