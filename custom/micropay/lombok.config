#
# Inherits the root lombok.config. Micropay service twins are @Service + @RequiredArgsConstructor copies of upstream
# implementations that upstream wires through @Bean factories with @Lazy parameters (e.g. LoanReadPlatformServiceImpl's
# InterestRefundServiceDelegate). Copying @Lazy from the field to the generated constructor parameter keeps the same
# cycle-breaking behaviour.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
