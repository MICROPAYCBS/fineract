<!--
  MICROPAY CBS: treasury P2.3. Pledges, market prices, fair value revaluation and IFRS 9 expected credit losses of
  treasury holdings: the deal columns, the fair value and impairment accounts on deal types, the stale price setting,
  the pledge, price, valuation, ECL and ECL parameter tables, the "Treasury Valuation" and "Treasury ECL" jobs and the
  permissions of the new commands.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0009_holdings_valuation.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="treasury.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="treasury.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="treasury-holding-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_deal" columnName="fv_adjustment"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_deal">
            <column name="fv_adjustment" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fv_last_value" type="DECIMAL(19,6)"/>
            <column name="fv_last_valuation_date" type="DATE"/>
            <column name="fv_last_price_date" type="DATE"/>
            <column name="ecl_stage" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="ecl_stage_reason" type="VARCHAR(500)"/>
            <column name="ecl_stage_date" type="DATE"/>
            <column name="ecl_manual_pd" type="DECIMAL(19,6)"/>
            <column name="ecl_manual_lgd" type="DECIMAL(19,6)"/>
            <column name="ecl_manual_amount" type="DECIMAL(19,6)"/>
            <column name="ecl_manual_reason" type="VARCHAR(500)"/>
            <column name="ecl_allowance" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ecl_calculated_on_date" type="DATE"/>
        </addColumn>
    </changeSet>

    <changeSet id="treasury-holding-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_deal_type" columnName="fv_adjustment_gl_account_id"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_deal_type">
            <column name="fv_adjustment_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_fv_adjustment" references="acc_gl_account(id)"/>
            </column>
            <column name="fv_gain_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_fv_gain" references="acc_gl_account(id)"/>
            </column>
            <column name="fv_loss_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_fv_loss" references="acc_gl_account(id)"/>
            </column>
            <column name="fv_reserve_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_fv_reserve" references="acc_gl_account(id)"/>
            </column>
            <column name="impairment_expense_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_impairment" references="acc_gl_account(id)"/>
            </column>
            <column name="ecl_allowance_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_ecl_allowance" references="acc_gl_account(id)"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="treasury-holding-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_setting" columnName="stale_price_days"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_setting">
            <column name="stale_price_days" type="INT" defaultValueNumeric="7">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="treasury-holding-004" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_pledge"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_pledge">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_pledge_deal" references="m_treasury_deal(id)"/>
            </column>
            <column name="pledgee_counterparty_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_pledge_pledgee" references="m_treasury_counterparty(id)"/>
            </column>
            <column name="purpose" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="linked_deal_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_pledge_linked_deal" references="m_treasury_deal(id)"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="expected_end_date" type="DATE"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="pledged_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="released_by" type="BIGINT"/>
            <column name="released_on_date" type="DATE"/>
            <column name="release_reason" type="VARCHAR(500)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_treasury_pledge" indexName="idx_treasury_pledge_deal">
            <column name="deal_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-holding-005" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_price"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_price">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="instrument_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="price_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="clean_price" type="DECIMAL(19,6)"/>
            <column name="yield_rate" type="DECIMAL(19,6)"/>
            <column name="source" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="entered_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_price" columnNames="instrument_id, price_date"
                             constraintName="uq_treasury_price_instrument_date"/>
    </changeSet>

    <changeSet id="treasury-holding-006" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_deal_valuation"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_deal_valuation">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_deal_valuation_deal" references="m_treasury_deal(id)"/>
            </column>
            <column name="sequence_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="valuation_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="price_date" type="DATE"/>
            <column name="clean_price" type="DECIMAL(19,6)"/>
            <column name="yield_rate" type="DECIMAL(19,6)"/>
            <column name="fair_value" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="amortised_cost" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="adjustment" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="adjustment_change" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="VARCHAR(50)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_deal_valuation" columnNames="deal_id, sequence_number"
                             constraintName="uq_treasury_deal_valuation_sequence"/>
    </changeSet>

    <changeSet id="treasury-holding-007" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_deal_ecl"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_deal_ecl">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_deal_ecl_deal" references="m_treasury_deal(id)"/>
            </column>
            <column name="sequence_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="calculation_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="stage" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="exposure" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="pd" type="DECIMAL(19,6)"/>
            <column name="lgd" type="DECIMAL(19,6)"/>
            <column name="basis" type="VARCHAR(60)"/>
            <column name="ecl" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="ecl_change" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="VARCHAR(50)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_deal_ecl" columnNames="deal_id, sequence_number"
                             constraintName="uq_treasury_deal_ecl_sequence"/>
    </changeSet>

    <changeSet id="treasury-holding-008" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_ecl_parameter"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_ecl_parameter">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rating_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="stage" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="pd_12_month" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="pd_lifetime" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="lgd" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="updated_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_ecl_parameter" columnNames="rating_code, stage"
                             constraintName="uq_treasury_ecl_parameter_rating_stage"/>
    </changeSet>

    <!-- Valuation after the accrual (02:30) and before the position snapshot (02:45); ECL monthly. Both inactive until set up. -->
    <changeSet id="treasury-holding-009" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM job WHERE short_name = 'TRS_VAL'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Treasury Valuation"/>
            <column name="display_name" value="Treasury Valuation"/>
            <column name="cron_expression" value="0 35 2 * * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Treasury Valuation _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="false"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
            <column name="short_name" value="TRS_VAL"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-holding-009-description" author="micropay">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="job" columnName="description"/>
        </preConditions>
        <update tableName="job">
            <column name="description" value="Revalues treasury bills and bonds held at FVOCI or FVTPL as at the closed business day from the latest market price, posting the change of their fair value adjustment. Runs after Treasury Accrual."/>
            <where>short_name='TRS_VAL' AND description IS NULL</where>
        </update>
    </changeSet>

    <changeSet id="treasury-holding-010" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM job WHERE short_name = 'TRS_ECL'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Treasury ECL"/>
            <column name="display_name" value="Treasury ECL"/>
            <column name="cron_expression" value="0 0 3 1 * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Treasury ECL _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="false"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
            <column name="short_name" value="TRS_ECL"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-holding-010-description" author="micropay">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="job" columnName="description"/>
        </preConditions>
        <update tableName="job">
            <column name="description" value="Recalculates the IFRS 9 expected credit loss of every settled treasury holding at amortised cost or FVOCI as at the closed business day, posting the change of its loss allowance."/>
            <where>short_name='TRS_ECL' AND description IS NULL</where>
        </update>
    </changeSet>

