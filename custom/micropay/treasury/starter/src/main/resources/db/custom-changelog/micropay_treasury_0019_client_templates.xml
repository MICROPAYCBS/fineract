<!--
  MICROPAY CBS: treasury P5.2. Onboarding by client type: the tenant's client type, the return frequency of a rule set,
  accounting classifications on asset classes (government securities held for trading and available for sale), and the
  setup permissions. The rule set and limit templates themselves are resources of the service, applied by apply-template.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0019_client_templates.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="treasury-setup-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_tenant_setting" columnName="client_type"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_tenant_setting">
            <column name="client_type" type="VARCHAR(20)"/>
        </addColumn>
    </changeSet>

    <changeSet id="treasury-setup-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_rule_set" columnName="return_frequency"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_rule_set">
            <column name="return_frequency" type="VARCHAR(20)"/>
        </addColumn>
    </changeSet>

    <changeSet id="treasury-setup-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_asset_class_rule" columnName="classifications"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_asset_class_rule">
            <column name="classifications" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

    <!-- The return frequency of the rule sets already seeded -->
    <changeSet id="treasury-setup-004" author="micropay">
        <update tableName="m_treasury_rule_set">
            <column name="return_frequency" value="MONTHLY"/>
            <where>code = 'BOU_MDI_2004' AND return_frequency IS NULL</where>
        </update>
        <update tableName="m_treasury_rule_set">
            <column name="return_frequency" value="WEEKLY"/>
            <where>code = 'BOU_FI_2023' AND return_frequency IS NULL</where>
        </update>
    </changeSet>

    <changeSet id="treasury-setup-perm-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'READ_TREASURYSETUP'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury_risk"/>
            <column name="code" value="READ_TREASURYSETUP"/>
            <column name="entity_name" value="TREASURYSETUP"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-setup-perm-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'APPLYTEMPLATE_TREASURYSETUP'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury_risk"/>
            <column name="code" value="APPLYTEMPLATE_TREASURYSETUP"/>
            <column name="entity_name" value="TREASURYSETUP"/>
            <column name="action_name" value="APPLYTEMPLATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-setup-perm-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'APPLYTEMPLATE_TREASURYSETUP_CHECKER'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury_risk"/>
            <column name="code" value="APPLYTEMPLATE_TREASURYSETUP_CHECKER"/>
            <column name="entity_name" value="TREASURYSETUP"/>
            <column name="action_name" value="APPLYTEMPLATE_CHECKER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
