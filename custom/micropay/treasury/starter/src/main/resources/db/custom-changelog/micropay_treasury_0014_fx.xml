<!--
  MICROPAY CBS: treasury P4.1. Exchange rates, FX revaluation settings and runs, core capital, two net open position
  limits (inactive placeholders), the "Treasury Currency Position and NOP" table report, the "Treasury FX Revaluation"
  job and the FX permissions.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0014_fx.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="treasury.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="treasury.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="treasury-fx-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_fx_rate"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_fx_rate">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="base_currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="quote_currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="rate_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="rate_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="rate" type="DECIMAL(24,10)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="superseded_by" type="BIGINT"/>
        </createTable>
        <createIndex tableName="m_treasury_fx_rate" indexName="idx_treasury_fx_rate_pair_date">
            <column name="base_currency"/>
            <column name="quote_currency"/>
            <column name="rate_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-fx-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_fx_reval_config"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_fx_reval_config">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="gl_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_fx_reval_config_gl" references="acc_gl_account(id)"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="adjustment_gl_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_fx_reval_config_adjustment" references="acc_gl_account(id)"/>
            </column>
            <column name="gain_gl_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_fx_reval_config_gain" references="acc_gl_account(id)"/>
            </column>
            <column name="loss_gl_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_fx_reval_config_loss" references="acc_gl_account(id)"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}"/>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_fx_reval_config" columnNames="gl_account_id, currency_code" constraintName="uq_treasury_fx_reval_config"/>
    </changeSet>

