<!--
  MICROPAY CBS: treasury P1.3. Statement import formats, imported statements and their lines, reconciliation matches
  and their items, the auto-match settings, the explanation reasons and the reconciliation permissions.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0006_reconciliation.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="treasury.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="treasury.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="treasury-recon-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_statement_format"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_statement_format">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_treasury_statement_format_code"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="format_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="delimiter_char" type="VARCHAR(1)"/>
            <column name="header_rows" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="date_format" type="VARCHAR(30)"/>
            <column name="decimal_separator" type="VARCHAR(1)"/>
            <column name="date_column" type="VARCHAR(100)"/>
            <column name="value_date_column" type="VARCHAR(100)"/>
            <column name="description_column" type="VARCHAR(100)"/>
            <column name="reference_column" type="VARCHAR(100)"/>
            <column name="debit_column" type="VARCHAR(100)"/>
            <column name="credit_column" type="VARCHAR(100)"/>
            <column name="amount_column" type="VARCHAR(100)"/>
            <column name="balance_column" type="VARCHAR(100)"/>
            <column name="invert_amount" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="treasury-recon-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_treasury_statement_format WHERE code = 'MT940'</sqlCheck>
        </preConditions>
        <insert tableName="m_treasury_statement_format">
            <column name="code" value="MT940"/>
            <column name="name" value="SWIFT MT940 customer statement"/>
            <column name="format_type" value="MT940"/>
            <column name="header_rows" valueNumeric="0"/>
            <column name="invert_amount" valueBoolean="false"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="created_on_utc" valueDate="${current_datetime}"/>
            <column name="created_by" valueNumeric="1"/>
            <column name="last_modified_on_utc" valueDate="${current_datetime}"/>
            <column name="last_modified_by" valueNumeric="1"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-recon-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_statement"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_statement">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="treasury_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_statement_account" references="m_treasury_account(id)"/>
            </column>
            <column name="format_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_statement_format" references="m_treasury_statement_format(id)"/>
            </column>
            <column name="statement_reference" type="VARCHAR(100)"/>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="file_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="period_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_to" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="opening_balance" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="closing_balance" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="line_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="imported_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="imported_on_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_statement" columnNames="treasury_account_id, file_hash"
                             constraintName="uq_treasury_statement_account_hash"/>
    </changeSet>

    <changeSet id="treasury-recon-004" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_recon_match"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_recon_match">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="treasury_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_recon_match_account" references="m_treasury_account(id)"/>
            </column>
            <column name="match_rule" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="matched_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="matched_on_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="reason_code_value_id" type="INT">
                <constraints nullable="true" foreignKeyName="fk_treasury_recon_match_reason" references="m_code_value(id)"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="adjustment_transaction_id" type="VARCHAR(50)"/>
            <column name="unmatched_by" type="BIGINT"/>
            <column name="unmatched_on_date" type="DATE"/>
            <column name="unmatch_reason" type="VARCHAR(500)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_treasury_recon_match" indexName="idx_treasury_recon_match_account_status">
            <column name="treasury_account_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-recon-005" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_statement_line"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_statement_line">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="statement_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_statement_line_statement" references="m_treasury_statement(id)"/>
            </column>
            <column name="treasury_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_statement_line_account" references="m_treasury_account(id)"/>
            </column>
            <column name="line_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="value_date" type="DATE"/>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="reference" type="VARCHAR(150)"/>
            <column name="running_balance" type="DECIMAL(19,6)"/>
            <column name="line_key" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="match_status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="match_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_statement_line_match" references="m_treasury_recon_match(id)"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_statement_line" columnNames="treasury_account_id, line_key"
                             constraintName="uq_treasury_statement_line_key"/>
        <createIndex tableName="m_treasury_statement_line" indexName="idx_treasury_statement_line_statement">
            <column name="statement_id"/>
            <column name="match_status"/>
        </createIndex>
        <createIndex tableName="m_treasury_statement_line" indexName="idx_treasury_statement_line_account_status">
            <column name="treasury_account_id"/>
            <column name="match_status"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-recon-006" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_recon_match_item"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_recon_match_item">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="match_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_recon_item_match" references="m_treasury_recon_match(id)"/>
            </column>
            <column name="statement_line_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_recon_item_line" references="m_treasury_statement_line(id)"/>
            </column>
            <column name="journal_entry_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_recon_item_entry" references="acc_gl_journal_entry(id)"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_treasury_recon_match_item" indexName="idx_treasury_recon_item_match">
            <column name="match_id"/>
        </createIndex>
        <createIndex tableName="m_treasury_recon_match_item" indexName="idx_treasury_recon_item_entry">
            <column name="journal_entry_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-recon-007" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_setting" columnName="recon_window_days"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_setting">
            <column name="recon_reference_rule" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="recon_same_date_rule" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="recon_window_rule" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="recon_window_days" type="INT" defaultValueNumeric="3">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

