<!--
  MICROPAY CBS: treasury P2.2. Deal accrual state and lifecycle columns, fee and amortisation methods and termination
  accounts on deal types, cash flow settlement, the accrual history, the cash flow and rollover settings, the "Treasury
  Accrual" job and the permissions of the settle cash flow, terminate and rollover commands.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0008_accruals_maturity.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="treasury.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="treasury.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="treasury-accrual-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_deal" columnName="accrued_to_date"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_deal">
            <column name="accrued_to_date" type="DATE"/>
            <column name="interest_accrued" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="amortisation_accrued" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fee_deferred" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="fee_amortised" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="interest_settled" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="principal_settled" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="matured_on_date" type="DATE"/>
            <column name="terminated_by" type="BIGINT"/>
            <column name="terminated_on_date" type="DATE"/>
            <column name="termination_proceeds" type="DECIMAL(19,6)"/>
            <column name="break_cost" type="DECIMAL(19,6)"/>
            <column name="realised_result" type="DECIMAL(19,6)"/>
            <column name="rollover_pre_approved" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="rolled_from_deal_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_deal_rolled_from" references="m_treasury_deal(id)"/>
            </column>
            <column name="rolled_to_deal_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_deal_rolled_to" references="m_treasury_deal(id)"/>
            </column>
            <column name="rolled_over_by" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <!-- deals settled before accrual existed accrue from their value date -->
    <changeSet id="treasury-accrual-002" author="micropay">
        <update tableName="m_treasury_deal">
            <column name="accrued_to_date" valueComputed="value_date"/>
            <where>status = 'SETTLED' AND accrued_to_date IS NULL</where>
        </update>
    </changeSet>

    <changeSet id="treasury-accrual-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_deal_type" columnName="fee_method"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_deal_type">
            <column name="fee_method" type="VARCHAR(30)" defaultValue="EXPENSE_IMMEDIATELY">
                <constraints nullable="false"/>
            </column>
            <column name="amortisation_method" type="VARCHAR(30)" defaultValue="EFFECTIVE_INTEREST">
                <constraints nullable="false"/>
            </column>
            <column name="deferred_fee_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_deferred_fee" references="acc_gl_account(id)"/>
            </column>
            <column name="realised_gain_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_realised_gain" references="acc_gl_account(id)"/>
            </column>
            <column name="realised_loss_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_trs_deal_type_realised_loss" references="acc_gl_account(id)"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="treasury-accrual-004" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_deal_cashflow" columnName="status"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_deal_cashflow">
            <column name="status" type="VARCHAR(20)" defaultValue="EXPECTED">
                <constraints nullable="false"/>
            </column>
            <column name="settled_amount" type="DECIMAL(19,6)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="settled_on_date" type="DATE"/>
            <column name="settlement_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="VARCHAR(50)"/>
        </addColumn>
    </changeSet>

    <changeSet id="treasury-accrual-005" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_deal_accrual"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_deal_accrual">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_deal_accrual_deal" references="m_treasury_deal(id)"/>
            </column>
            <column name="sequence_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="interest" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="amortisation" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="fee_amortisation" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="VARCHAR(50)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_deal_accrual" columnNames="deal_id, sequence_number"
                             constraintName="uq_treasury_deal_accrual_sequence"/>
    </changeSet>

    <changeSet id="treasury-accrual-006" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_setting" columnName="auto_settle_cashflows"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_setting">
            <column name="auto_settle_cashflows" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="rollover_window_days" type="INT" defaultValueNumeric="3">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Accrual job, inactive until set up; it belongs before the position snapshot in a job sequence -->
    <changeSet id="treasury-accrual-007" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM job WHERE short_name = 'TRS_ACCR'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Treasury Accrual"/>
            <column name="display_name" value="Treasury Accrual"/>
            <column name="cron_expression" value="0 30 2 * * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Treasury Accrual _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="false"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
            <column name="short_name" value="TRS_ACCR"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-accrual-008" author="micropay">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="job" columnName="description"/>
        </preConditions>
        <update tableName="job">
            <column name="description" value="Accrues every settled treasury deal through the closed business day (business date less one), settles the deal cash flows due, and matures deals whose cash flows are all settled."/>
            <where>short_name='TRS_ACCR' AND description IS NULL</where>
        </update>
    </changeSet>

    <changeSet id="treasury-accrual-perm-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'SETTLECASHFLOW_TREASURYDEAL'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury"/>
            <column name="code" value="SETTLECASHFLOW_TREASURYDEAL"/>
            <column name="entity_name" value="TREASURYDEAL"/>
            <column name="action_name" value="SETTLECASHFLOW"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-accrual-perm-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'SETTLECASHFLOW_TREASURYDEAL_CHECKER'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury"/>
            <column name="code" value="SETTLECASHFLOW_TREASURYDEAL_CHECKER"/>
            <column name="entity_name" value="TREASURYDEAL"/>
            <column name="action_name" value="SETTLECASHFLOW_CHECKER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-accrual-perm-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'TERMINATE_TREASURYDEAL'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury"/>
            <column name="code" value="TERMINATE_TREASURYDEAL"/>
            <column name="entity_name" value="TREASURYDEAL"/>
            <column name="action_name" value="TERMINATE"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-accrual-perm-004" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'TERMINATE_TREASURYDEAL_CHECKER'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury"/>
            <column name="code" value="TERMINATE_TREASURYDEAL_CHECKER"/>
            <column name="entity_name" value="TREASURYDEAL"/>
            <column name="action_name" value="TERMINATE_CHECKER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-accrual-perm-005" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'ROLLOVER_TREASURYDEAL'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury"/>
            <column name="code" value="ROLLOVER_TREASURYDEAL"/>
            <column name="entity_name" value="TREASURYDEAL"/>
            <column name="action_name" value="ROLLOVER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-accrual-perm-006" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_permission WHERE code = 'ROLLOVER_TREASURYDEAL_CHECKER'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="treasury"/>
            <column name="code" value="ROLLOVER_TREASURYDEAL_CHECKER"/>
            <column name="entity_name" value="TREASURYDEAL"/>
            <column name="action_name" value="ROLLOVER_CHECKER"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

</databaseChangeLog>
