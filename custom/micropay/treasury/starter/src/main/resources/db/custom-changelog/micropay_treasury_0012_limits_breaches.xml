    <changeSet id="treasury-limits-report-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM stretchy_report WHERE report_name = 'Treasury Limit Breaches'</sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Treasury Limit Breaches"/>
            <column name="report_type" value="Table"/>
            <column name="report_category" value="Accounting"/>
            <column name="report_sql" value="SELECT b.id AS breach_id, b.limit_code, l.name AS limit_name, b.metric, b.metric_key, b.scope_type, b.scope_label, b.currency_code AS currency, b.level_hit AS level, b.status, b.observed_value, b.comparison, b.warning_level, b.hard_level, b.unit, b.first_seen_on, b.last_seen_on, b.occurrences, b.escalated_on, b.cleared_on, b.acknowledged_on_utc, b.resolved_on_date, b.resolution_comment, b.detail FROM m_treasury_breach b JOIN m_treasury_limit l ON l.id = b.limit_id WHERE b.first_seen_on &lt;= '${asOn}' AND (b.resolved_on_date IS NULL OR b.resolved_on_date &gt;= '${asOn}') ORDER BY CASE b.level_hit WHEN 'HARD' THEN 0 ELSE 1 END, b.first_seen_on, b.id"/>
            <column name="description" value="The breaches of treasury limits open on a date (first seen on or before it, not resolved before it), with their levels, occurrences and handling."/>
            <column name="core_report" valueBoolean="false"/>
            <column name="use_report" valueBoolean="true"/>
            <column name="self_service_user_report" valueBoolean="false"/>
        </insert>
        <insert tableName="stretchy_report_parameter">
            <column name="report_id" valueComputed="(SELECT id FROM stretchy_report WHERE report_name = 'Treasury Limit Breaches')"/>
            <column name="parameter_id" valueComputed="(SELECT id FROM stretchy_parameter WHERE parameter_name = 'asOnDate')"/>
            <column name="report_parameter_name" value="asOn"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="report"/>
            <column name="code" value="READ_Treasury Limit Breaches"/>
            <column name="entity_name" value="Treasury Limit Breaches"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

