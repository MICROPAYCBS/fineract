<!--
  MICROPAY CBS: treasury P3.3. The limits engine and breach log: limits with their version history, stored evaluations
  and their lines, breaches with their comment threads, example limits (inactive placeholders), the "Treasury Limit
  Breaches" table report, the "Treasury Limits" job and the limit and breach permissions.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0012_limits_breaches.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="treasury.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="treasury.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="treasury-limits-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_limit"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_limit">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="metric" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="metric_key" type="VARCHAR(50)"/>
            <column name="gap_type" type="VARCHAR(20)"/>
            <column name="gap_basis" type="VARCHAR(30)"/>
            <column name="top_n" type="INT"/>
            <column name="scope_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="scope_id" type="BIGINT"/>
            <column name="currency_code" type="VARCHAR(3)"/>
            <column name="comparison" type="VARCHAR(10)"/>
            <column name="warning_level" type="DECIMAL(19,6)"/>
            <column name="hard_level" type="DECIMAL(19,6)"/>
            <column name="unit" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="use_own_levels" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_from" type="DATE"/>
            <column name="effective_to" type="DATE"/>
            <column name="notify_role_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_limit_notify_role" references="m_role(id)"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}"/>
            <column name="activated_by" type="BIGINT"/>
            <column name="activated_on_date" type="DATE"/>
        </createTable>
        <addUniqueConstraint tableName="m_treasury_limit" columnNames="code" constraintName="uq_treasury_limit_code"/>
    </changeSet>

    <changeSet id="treasury-limits-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_limit_history"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_limit_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="limit_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_limit_history_limit" references="m_treasury_limit(id)"/>
            </column>
            <column name="version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="snapshot" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="BIGINT"/>
            <column name="changed_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_treasury_limit_history" indexName="idx_treasury_limit_history_limit">
            <column name="limit_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-limits-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_limit_evaluation"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_limit_evaluation">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="as_of_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="office_id" type="BIGINT"/>
            <column name="trigger_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="source_run_id" type="BIGINT"/>
            <column name="source_deal_id" type="BIGINT"/>
            <column name="limits_evaluated" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="breaches_created" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="breaches_escalated" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="breaches_repeated" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="breaches_cleared" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_treasury_limit_evaluation" indexName="idx_treasury_limit_evaluation_date">
            <column name="as_of_date"/>
            <column name="currency_code"/>
        </createIndex>
        <createIndex tableName="m_treasury_limit_evaluation" indexName="idx_treasury_limit_evaluation_run">
            <column name="source_run_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-limits-004" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_breach"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_breach">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="limit_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_breach_limit" references="m_treasury_limit(id)"/>
            </column>
            <column name="limit_code" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="limit_version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="metric" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="metric_key" type="VARCHAR(50)"/>
            <column name="scope_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="scope_id" type="BIGINT"/>
            <column name="scope_label" type="VARCHAR(200)"/>
            <column name="currency_code" type="VARCHAR(3)"/>
            <column name="as_of_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="observed_value" type="DECIMAL(19,6)"/>
            <column name="level_hit" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="last_level" type="VARCHAR(10)"/>
            <column name="comparison" type="VARCHAR(10)"/>
            <column name="warning_level" type="DECIMAL(19,6)"/>
            <column name="hard_level" type="DECIMAL(19,6)"/>
            <column name="unit" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="source_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="source_id" type="BIGINT"/>
            <column name="evaluation_id" type="BIGINT"/>
            <column name="detail" type="VARCHAR(1000)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="first_seen_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="last_seen_on" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="occurrences" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="escalated_on" type="DATE"/>
            <column name="cleared_on" type="DATE"/>
            <column name="acknowledged_by" type="BIGINT"/>
            <column name="acknowledged_on_utc" type="${treasury.datetime.type}"/>
            <column name="resolved_by" type="BIGINT"/>
            <column name="resolved_on_date" type="DATE"/>
            <column name="resolved_on_utc" type="${treasury.datetime.type}"/>
            <column name="resolution_comment" type="VARCHAR(2000)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_treasury_breach" indexName="idx_treasury_breach_limit_status">
            <column name="limit_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="m_treasury_breach" indexName="idx_treasury_breach_status">
            <column name="status"/>
            <column name="last_seen_on"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-limits-005" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_breach_comment"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_breach_comment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="breach_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_breach_comment_breach" references="m_treasury_breach(id)"/>
            </column>
            <column name="kind" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="comment_text" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="m_treasury_breach_comment" indexName="idx_treasury_breach_comment_breach">
            <column name="breach_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-limits-006" author="micropay">
        <preConditions onFail="MARK_RAN">
