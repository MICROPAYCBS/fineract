<!--
  MICROPAY CBS: treasury P1.2. Per-currency settings, funding transfers with an in-transit state, agent floats and their
  top-up and sweep requests. Links to upstream tables are by id; agent floats keep foreign keys to the client and
  savings account they belong to.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0003_transfers_and_agent_floats.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="treasury.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="treasury.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>

    <!-- Settings per currency -->
    <changeSet id="treasury-transfer-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_setting"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_setting">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_treasury_setting_currency"/>
            </column>
            <column name="cash_in_transit_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_setting_in_transit_gl" references="acc_gl_account(id)"/>
            </column>
            <column name="float_payment_type_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_setting_payment_type" references="m_payment_type(id)"/>
            </column>
            <column name="allow_insufficient_balance" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Funding transfers between treasury accounts -->
    <changeSet id="treasury-transfer-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_transfer"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_transfer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="from_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_transfer_from" references="m_treasury_account(id)"/>
            </column>
            <column name="to_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_transfer_to" references="m_treasury_account(id)"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="transfer_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="reference" type="VARCHAR(100)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by" type="BIGINT"/>
            <column name="approved_on_date" type="DATE"/>
            <column name="sent_by" type="BIGINT"/>
            <column name="sent_on_date" type="DATE"/>
            <column name="send_transaction_id" type="VARCHAR(50)"/>
            <column name="received_by" type="BIGINT"/>
            <column name="received_on_date" type="DATE"/>
            <column name="receive_transaction_id" type="VARCHAR(50)"/>
            <column name="cancelled_by" type="BIGINT"/>
            <column name="cancelled_on_date" type="DATE"/>
            <column name="in_transit_gl_account_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_transfer_in_transit_gl" references="acc_gl_account(id)"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="treasury-transfer-003" author="micropay">
        <createIndex tableName="m_treasury_transfer" indexName="idx_treasury_transfer_from_status">
            <column name="from_account_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="m_treasury_transfer" indexName="idx_treasury_transfer_to_status">
            <column name="to_account_id"/>
            <column name="status"/>
        </createIndex>
        <createIndex tableName="m_treasury_transfer" indexName="idx_treasury_transfer_date">
            <column name="transfer_date"/>
        </createIndex>
    </changeSet>

    <!-- An agent's float savings account -->
    <changeSet id="treasury-transfer-004" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_agent_float"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_agent_float">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_agent_float_client" references="m_client(id)"/>
            </column>
            <column name="savings_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_agent_float_savings" references="m_savings_account(id)"/>
            </column>
            <column name="treasury_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_agent_float_account" references="m_treasury_account(id)"/>
            </column>
            <column name="min_float" type="DECIMAL(19,6)"/>
            <column name="max_float" type="DECIMAL(19,6)"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="treasury-transfer-005" author="micropay">
        <createIndex tableName="m_treasury_agent_float" indexName="idx_treasury_agent_float_savings">
            <column name="savings_account_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- Top-up and sweep requests -->
    <changeSet id="treasury-transfer-006" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_float_request"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_float_request">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="agent_float_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_float_request_float" references="m_treasury_agent_float(id)"/>
            </column>
            <column name="request_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="approved_by" type="BIGINT"/>
            <column name="approved_on_date" type="DATE"/>
            <column name="executed_by" type="BIGINT"/>
            <column name="executed_on_date" type="DATE"/>
            <column name="savings_transaction_id" type="BIGINT"/>
            <column name="cancelled_by" type="BIGINT"/>
            <column name="cancelled_on_date" type="DATE"/>
            <column name="note" type="VARCHAR(500)"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="treasury-transfer-007" author="micropay">
        <createIndex tableName="m_treasury_float_request" indexName="idx_treasury_float_request_float_status">
            <column name="agent_float_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
