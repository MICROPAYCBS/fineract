<!--
  MICROPAY CBS: treasury P4.3 follow-up. A unique open key on m_treasury_breach, so that concurrent evaluations of a limit
  cannot open two breaches for one subject and currency.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0017_breach_open_key.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- One breach in progress (OPEN or ACKNOWLEDGED) per limit, subject and currency: open_key is set while the breach is
         in progress and nulled on resolve, with a unique index on it. MySQL has no partial indexes, and both databases
         allow many NULLs in a unique index. -->
    <changeSet id="treasury-breach-key-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="m_treasury_breach" columnName="open_key"/>
            </not>
        </preConditions>
        <addColumn tableName="m_treasury_breach">
            <column name="open_key" type="VARCHAR(120)"/>
        </addColumn>
        <update tableName="m_treasury_breach">
            <column name="open_key" valueComputed="CONCAT(limit_id, '|', scope_type, '|', COALESCE(scope_id, 0), '|', COALESCE(currency_code, ''))"/>
            <where>status IN ('OPEN', 'ACKNOWLEDGED')</where>
        </update>
    </changeSet>

    <!-- Should a tenant already hold two breaches in progress for one key, only the latest keeps it; the others stay as
         they are, without a key, until resolved -->
    <changeSet id="treasury-breach-key-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="m_treasury_breach" columnName="open_key"/>
        </preConditions>
        <sql>UPDATE m_treasury_breach SET open_key = NULL WHERE open_key IS NOT NULL AND id NOT IN (SELECT keep_id FROM (SELECT MAX(id) AS keep_id FROM m_treasury_breach WHERE open_key IS NOT NULL GROUP BY open_key) k)</sql>
    </changeSet>

    <changeSet id="treasury-breach-key-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="m_treasury_breach" indexName="uq_treasury_breach_open"/>
            </not>
        </preConditions>
        <createIndex tableName="m_treasury_breach" indexName="uq_treasury_breach_open" unique="true">
            <column name="open_key"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
