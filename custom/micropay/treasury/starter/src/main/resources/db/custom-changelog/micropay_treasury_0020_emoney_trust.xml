            <column name="coverage_percent" type="DECIMAL(19,6)"/>
            <column name="max_concentration_percent" type="DECIMAL(19,6)"/>
            <column name="concentration_threshold" type="DECIMAL(19,6)"/>
            <column name="concentration_applies" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex unique="true" tableName="m_treasury_run_trust" indexName="uq_treasury_run_trust_run">
            <column name="run_id"/>
        </createIndex>
    </changeSet>

