<!--
  MICROPAY CBS: treasury P5.3. E-money trust safeguarding for payment service providers (NPS Act 2020, NPS Regulations
  2021): trust account details, deals held in trust, imported e-money balances, the TRUST_RECON run with its lines,
  trust interest, the e-money source settings, the treasury_trust permissions, the Treasury Trust Reconciliation job
  (inactive), the trust limits (inactive) and two reports.
-->
<databaseChangeLog logicalFilePath="db/changelog/tenant/module/treasury/parts/0020_emoney_trust.xml" xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <property name="treasury.datetime.type" value="DATETIME" dbms="mysql,mariadb"/>
    <property name="treasury.datetime.type" value="TIMESTAMP WITH TIME ZONE" dbms="postgresql"/>
    <property name="current_datetime" value="NOW()"/>

    <changeSet id="treasury-trust-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_trust_account"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_trust_account">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="treasury_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_trust_account_account" references="m_treasury_account(id)"/>
            </column>
            <column name="bank_counterparty_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_treasury_trust_account_bank" references="m_treasury_counterparty(id)"/>
            </column>
            <column name="trustee_name" type="VARCHAR(150)"/>
            <column name="trust_deed_reference" type="VARCHAR(100)"/>
            <column name="last_modified_by" type="BIGINT"/>
            <column name="last_modified_on_utc" type="${treasury.datetime.type}"/>
        </createTable>
        <createIndex unique="true" tableName="m_treasury_trust_account" indexName="uq_treasury_trust_account">
            <column name="treasury_account_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-trust-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_trust_holding"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_trust_holding">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="deal_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_trust_holding_deal" references="m_treasury_deal(id)"/>
            </column>
            <column name="trust_account_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_treasury_trust_holding_account" references="m_treasury_account(id)"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex unique="true" tableName="m_treasury_trust_holding" indexName="uq_treasury_trust_holding_deal">
            <column name="deal_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="treasury-trust-003" author="micropay">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_treasury_emoney_balance"/>
            </not>
        </preConditions>
        <createTable tableName="m_treasury_emoney_balance">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="balance_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="VARCHAR(500)"/>
            <column name="created_by" type="BIGINT"/>
            <column name="created_on_utc" type="${treasury.datetime.type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex unique="true" tableName="m_treasury_emoney_balance" indexName="uq_treasury_emoney_balance">
            <column name="balance_date"/>
            <column name="currency_code"/>
            <column name="category"/>
        </createIndex>
    </changeSet>

