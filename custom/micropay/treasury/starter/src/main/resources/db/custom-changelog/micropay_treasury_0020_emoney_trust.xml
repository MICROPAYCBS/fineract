            <column name="emoney_other" type="DECIMAL(19,6)"/>
            <column name="emoney_total" type="DECIMAL(19,6)"/>
            <column name="trust_total" type="DECIMAL(19,6)"/>
            <column name="eligible_total" type="DECIMAL(19,6)"/>
            <column name="encumbered_total" type="DECIMAL(19,6)"/>
            <column name="ineligible_total" type="DECIMAL(19,6)"/>
            <column name="difference_amount" type="DECIMAL(19,6)"/>
