    <!-- The daily trust reconciliation after the position snapshot (02:45), before the liquidity run; inactive until set up -->
    <changeSet id="treasury-trust-job-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM job WHERE short_name = 'TRS_TRST'</sqlCheck>
        </preConditions>
        <insert tableName="job">
            <column name="name" value="Treasury Trust Reconciliation"/>
            <column name="display_name" value="Treasury Trust Reconciliation"/>
            <column name="cron_expression" value="0 47 2 * * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Treasury Trust Reconciliation _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="false"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="1"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
            <column name="short_name" value="TRS_TRST"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-trust-job-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="job" columnName="description"/>
        </preConditions>
        <update tableName="job">
            <column name="description" value="Reconciles the e-money outstanding against the assets held in trust for the closed business day in every currency with a TRUST account, records the interest earned on the trust, and evaluates the trust limits (a breach is notified at once). Runs after Treasury Position Snapshot."/>
            <where>short_name='TRS_TRST' AND description IS NULL</where>
        </update>
    </changeSet>

    <!-- The e-money trust limits, inactive; apply-template PSP activates them with the BOU_NPS_2021 rule set -->
    <changeSet id="treasury-trust-limits-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM m_treasury_limit WHERE code IN ('TRUST_COVERAGE_MIN', 'TRUST_BANK_CONCENTRATION_MAX', 'TRUST_SHORTFALL_MAX')</sqlCheck>
        </preConditions>
        <insert tableName="m_treasury_limit">
            <column name="code" value="TRUST_COVERAGE_MIN"/>
            <column name="name" value="E-money covered 100% by unencumbered liquid trust assets (NPS Act 2020 s.60)"/>
            <column name="description" value="Regulatory hard limit: eligible trust assets at least 100% of e-money outstanding. The warning at 102% is a placeholder."/>
            <column name="metric" value="TRUST_COVERAGE"/>
            <column name="scope_type" value="INSTITUTION"/>
            <column name="comparison" value="MIN"/>
            <column name="warning_level" valueNumeric="102"/>
            <column name="hard_level" valueNumeric="100"/>
            <column name="unit" value="PERCENT"/>
            <column name="use_own_levels" valueBoolean="false"/>
            <column name="status" value="INACTIVE"/>
            <column name="version" valueNumeric="1"/>
            <column name="created_on_utc" valueDate="${current_datetime}"/>
        </insert>
        <insert tableName="m_treasury_limit_history">
            <column name="limit_id" valueComputed="(SELECT id FROM m_treasury_limit WHERE code = 'TRUST_COVERAGE_MIN')"/>
            <column name="version" valueNumeric="1"/>
            <column name="action" value="CREATE"/>
            <column name="snapshot" value='{"code":"TRUST_COVERAGE_MIN","name":"E-money covered 100% by unencumbered liquid trust assets (NPS Act 2020 s.60)","description":"Regulatory hard limit: eligible trust assets at least 100% of e-money outstanding. The warning at 102% is a placeholder.","metric":"TRUST_COVERAGE","scopeType":"INSTITUTION","comparison":"MIN","warningLevel":"102","hardLevel":"100","unit":"PERCENT","status":"INACTIVE"}'/>
            <column name="changed_on_utc" valueDate="${current_datetime}"/>
        </insert>
        <insert tableName="m_treasury_limit">
            <column name="code" value="TRUST_BANK_CONCENTRATION_MAX"/>
            <column name="name" value="At most 20% of e-money held at one institution (NPS Regulations 2021 reg 15(2)-(3))"/>
            <column name="description" value="Regulatory hard limit per institution; it does not apply while total e-money is at most UGX 500m. The warning at 18% is a placeholder."/>
            <column name="metric" value="TRUST_BANK_CONCENTRATION"/>
            <column name="scope_type" value="INSTITUTION"/>
            <column name="comparison" value="MAX"/>
            <column name="warning_level" valueNumeric="18"/>
            <column name="hard_level" valueNumeric="20"/>
            <column name="unit" value="PERCENT"/>
            <column name="use_own_levels" valueBoolean="false"/>
            <column name="status" value="INACTIVE"/>
            <column name="version" valueNumeric="1"/>
            <column name="created_on_utc" valueDate="${current_datetime}"/>
        </insert>
        <insert tableName="m_treasury_limit_history">
            <column name="limit_id" valueComputed="(SELECT id FROM m_treasury_limit WHERE code = 'TRUST_BANK_CONCENTRATION_MAX')"/>
            <column name="version" valueNumeric="1"/>
            <column name="action" value="CREATE"/>
            <column name="snapshot" value='{"code":"TRUST_BANK_CONCENTRATION_MAX","name":"At most 20% of e-money held at one institution (NPS Regulations 2021 reg 15(2)-(3))","description":"Regulatory hard limit per institution; it does not apply while total e-money is at most UGX 500m. The warning at 18% is a placeholder.","metric":"TRUST_BANK_CONCENTRATION","scopeType":"INSTITUTION","comparison":"MAX","warningLevel":"18","hardLevel":"20","unit":"PERCENT","status":"INACTIVE"}'/>
            <column name="changed_on_utc" valueDate="${current_datetime}"/>
