    <changeSet id="treasury-trust-report-001" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM stretchy_report WHERE report_name = 'Treasury E-Money Trust Reconciliation'</sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Treasury E-Money Trust Reconciliation"/>
            <column name="report_type" value="Table"/>
            <column name="report_category" value="Accounting"/>
            <column name="report_sql" value="SELECT r.currency_code AS currency, r.id AS run_id, r.status, t.emoney_source, t.emoney_customers, t.emoney_agents, t.emoney_other, t.emoney_total, t.trust_total, t.eligible_total, t.encumbered_total, t.ineligible_total, t.difference_amount AS difference, t.shortfall, t.coverage_percent, t.max_concentration_percent, t.concentration_applies FROM m_treasury_run r JOIN m_treasury_run_trust t ON t.run_id = r.id WHERE r.run_type = 'TRUST_RECON' AND r.office_id IS NULL AND r.as_of_date = '${asOn}' ORDER BY r.currency_code"/>
            <column name="description" value="The daily e-money trust reconciliation of a date (NPS Regulations 2021 reg 22(5)): e-money by category, trust assets, eligible assets, difference, shortfall, coverage and the largest institution concentration."/>
            <column name="core_report" valueBoolean="false"/>
            <column name="use_report" valueBoolean="true"/>
            <column name="self_service_user_report" valueBoolean="false"/>
        </insert>
        <insert tableName="stretchy_report_parameter">
            <column name="report_id" valueComputed="(SELECT id FROM stretchy_report WHERE report_name = 'Treasury E-Money Trust Reconciliation')"/>
            <column name="parameter_id" valueComputed="(SELECT id FROM stretchy_parameter WHERE parameter_name = 'asOnDate')"/>
            <column name="report_parameter_name" value="asOn"/>
        </insert>
        <insert tableName="m_permission">
            <column name="grouping" value="report"/>
            <column name="code" value="READ_Treasury E-Money Trust Reconciliation"/>
            <column name="entity_name" value="Treasury E-Money Trust Reconciliation"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet id="treasury-trust-report-002" author="micropay">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM stretchy_report WHERE report_name = 'Treasury Trust Asset Breakdown'</sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Treasury Trust Asset Breakdown"/>
            <column name="report_type" value="Table"/>
            <column name="report_category" value="Accounting"/>
            <column name="report_sql" value="SELECT r.currency_code AS currency, COALESCE(l.institution_name, 'Not set') AS institution, l.asset_type, SUM(l.amount) AS amount, SUM(COALESCE(l.eligible_amount, 0)) AS eligible, SUM(COALESCE(l.encumbered_amount, 0)) AS encumbered FROM m_treasury_run r JOIN m_treasury_run_trust_line l ON l.run_id = r.id WHERE r.run_type = 'TRUST_RECON' AND r.office_id IS NULL AND r.as_of_date = '${asOn}' AND l.line_type = 'ASSET' GROUP BY r.currency_code, COALESCE(l.institution_name, 'Not set'), l.asset_type ORDER BY 1, 2, 3"/>
            <column name="description" value="The trust balances of a date by institution and asset type (NPS Regulations 2021 reg 22(6)): demand deposits, term deposits, treasury bills and bonds."/>
            <column name="core_report" valueBoolean="false"/>
            <column name="use_report" valueBoolean="true"/>
            <column name="self_service_user_report" valueBoolean="false"/>
        </insert>
        <insert tableName="stretchy_report_parameter">
            <column name="report_id" valueComputed="(SELECT id FROM stretchy_report WHERE report_name = 'Treasury Trust Asset Breakdown')"/>
            <column name="parameter_id" valueComputed="(SELECT id FROM stretchy_parameter WHERE parameter_name = 'asOnDate')"/>
            <column name="report_parameter_name" value="asOn"/>
