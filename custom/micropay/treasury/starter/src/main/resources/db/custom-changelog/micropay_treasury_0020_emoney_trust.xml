            <column name="asset_type" type="VARCHAR(20)"/>
            <column name="institution_id" type="BIGINT"/>
            <column name="institution_name" type="VARCHAR(150)"/>
            <column name="trust_account_id" type="BIGINT"/>
            <column name="deal_id" type="BIGINT"/>
            <column name="label" type="VARCHAR(200)"/>
            <column name="amount" type="DECIMAL(19,6)">
                <constraints nullable="false"/>
            </column>
            <column name="eligible_amount" type="DECIMAL(19,6)"/>
            <column name="encumbered_amount" type="DECIMAL(19,6)"/>
        </createTable>
        <createIndex tableName="m_treasury_run_trust_line" indexName="idx_treasury_run_trust_line_run">
