<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet author="fineract" id="workflow-config-001" context="postgresql">
        <sql>
            SELECT SETVAL('c_configuration_id_seq', COALESCE(MAX(id), 0)+1, false)
            FROM c_configuration;
        </sql>
    </changeSet>

    <changeSet author="fineract" id="workflow-config-002">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(1) FROM c_configuration WHERE name = 'enable-approval-workflows'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="enable-approval-workflows"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description"
                    value="When enabled, business transactions are governed by the configured approval workflows for this tenant. When disabled, transactions proceed without workflow approval even if active workflow definitions exist. Disabled by default so that smaller institutions are unaffected until they opt in."/>
        </insert>
    </changeSet>
</databaseChangeLog>
