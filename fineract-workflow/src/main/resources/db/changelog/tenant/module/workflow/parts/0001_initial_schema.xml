    <!-- Create m_workflow_definition table - MySQL -->
    <changeSet id="workflow-001" author="fineract" context="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="m_workflow_definition"/>
            </not>
        </preConditions>
        <createTable tableName="m_workflow_definition">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_permission_code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="true"/>
            </column>
            <column name="min_amount" type="DECIMAL(19,6)">
                <constraints nullable="true"/>
            </column>
            <column name="max_amount" type="DECIMAL(19,6)">
                <constraints nullable="true"/>
            </column>
            <column name="created_on_utc" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_on_utc" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

